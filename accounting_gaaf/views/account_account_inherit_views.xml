<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_account_tree_inherit_ag" model="ir.ui.view">
    <field name="name">view.account.form.inherited</field>
    <field name="model">account.account</field>
    <field name="inherit_id" ref="account.view_account_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='account_type']" position="after">
        <field name="account_local_code" optional="show" string="Catalogo Local"/>
      </xpath>
    </field>
  </record>

  <record id="view_account_account_tree_inherit_catalogo_ag" model="ir.ui.view">
    <field name="name">account.account.tree.inherited.catalogo_ag</field>
    <field name="model">account.account</field>
    <field name="inherit_id" ref="account.view_account_list"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='account_type']" position="after">
        <field name="account_local_code" optional="show" string="código de equivalencia" />
      </xpath>
    </field>
  </record>
</odoo>
